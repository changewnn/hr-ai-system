APP_ENV=development
HR_APP_NAME=HR AI System API
HR_DEBUG=true
HR_HOST=127.0.0.1
HR_PORT=8000
HR_LOG_LEVEL=INFO
HR_TIMEZONE=Asia/Shanghai
HR_SECRET_KEY=replace-with-a-random-string-at-least-16-chars
HR_JWT_EXPIRE_HOURS=8
HR_DATABASE_URL=postgresql+asyncpg://hr:hr@localhost:5432/hr_system
HR_REDIS_URL=redis://localhost:6379/0

# M10 policy knowledge base (Qwen OpenAI-compatible embedding API)
HR_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HR_EMBEDDING_API_KEY=
HR_EMBEDDING_MODEL=text-embedding-v3
HR_EMBEDDING_DIMENSION=1024
HR_EMBEDDING_TIMEOUT_SECONDS=30
HR_KNOWLEDGE_STORAGE_PATH=data/knowledge
HR_KNOWLEDGE_MAX_FILE_MB=20
HR_KNOWLEDGE_CHUNK_SIZE=2400
HR_KNOWLEDGE_CHUNK_OVERLAP=300

# M10 Agent RAG (DeepSeek OpenAI-compatible API)
HR_LLM_BASE_URL=https://api.deepseek.com/v1
HR_LLM_API_KEY=
HR_LLM_MODEL=deepseek-chat
HR_LLM_TIMEOUT_SECONDS=30
HR_AGENT_ENABLED=false
HR_AGENT_MAX_INPUT_CHARS=4000
HR_AGENT_MAX_CONTEXT_CHUNKS=4
HR_AGENT_RATE_LIMIT_PER_MINUTE=30
HR_AGENT_SSE_RATE_LIMIT_PER_MINUTE=10
HR_AGENT_RETENTION_DAYS=180
