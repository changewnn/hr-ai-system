APP_ENV=development
NGINX_PORT=8080
POSTGRES_DB=hr_ai_system
POSTGRES_USER=langchain_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

HR_SECRET_KEY=replace-with-a-random-string-at-least-32-chars
HR_JWT_EXPIRE_HOURS=8

# Docker Compose service names are used inside the network.
HR_DATABASE_URL=postgresql+asyncpg://langchain_user:replace-with-a-strong-postgres-password@postgres:5432/hr_ai_system
HR_REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0

HR_AGENT_ENABLED=false
HR_AGENT_RATE_LIMIT_PER_MINUTE=30
HR_AGENT_SSE_RATE_LIMIT_PER_MINUTE=10
HR_AGENT_RETENTION_DAYS=180

HR_EMBEDDING_BASE_URL=
HR_EMBEDDING_API_KEY=
HR_EMBEDDING_MODEL=text-embedding-v3
HR_EMBEDDING_DIMENSION=1024
HR_LLM_BASE_URL=
HR_LLM_API_KEY=
HR_LLM_MODEL=deepseek-chat
